{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(du:*)",
      "Bash(df)",
      "Bash(ps:*)",
      "Bash(lsof:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(ast-grep:*)",
      "Bash(fzf:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rmdir:*)",
      "Bash(chmod:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git reflog)",
      "Bash(git merge-base:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(tsc:*)",
      "Bash(jest:*)",
      "Bash(vitest:*)",
      "Read(package.json)",
      "Read(tsconfig.json)",
      "Read(jsconfig.json)",
      "Read(.env.example)",
      "Read(~/.zshrc)",
      "Read(~/.bashrc)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(nc:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(git clone:*)",
      "Bash(yarn dev:*)",
      "Bash(yarn start:*)",
      "Bash(yarn serve:*)",
      "Bash(yarn install:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm add:*)",
      "Bash(pip install:*)",
      "Bash(op:*)",
      "Bash(pass:*)",
      "Bash(gpg:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(reboot)",
      "Bash(shutdown:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(redis-cli:*)",
      "Bash(mongo:*)",
      "Write(.env)",
      "Write(~/.ssh/*)",
      "Write(/etc/*)"
    ]
  }
}