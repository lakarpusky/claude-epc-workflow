{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git reset:*)",
      "Bash(git tag:*)",
      "Bash(yarn build:*)",
      "Bash(yarn test:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn lint:js:*)",
      "Bash(yarn lint:prettier:*)",
      "Bash(yarn format:*)",
      "Bash(yarn precommit:*)",
      "Bash(yarn copy-workers:*)",
      "Bash(yarn list)",
      "Bash(yarn audit)",
      "Bash(test:*)",
      "Bash(vite:*)",
      "Bash(webpack:*)",
      "Bash(madge:*)",
      "Bash(npx madge:*)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(node -e:*)",
      "Bash(node --check:*)",
      "Bash(node -c:*)",
      "Bash(echo:*)",
      "Bash(true)"
    ],
    "deny": [
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git rebase -i:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); echo \"$cmd\" | grep -q 'git commit' && jq -n --arg files \"$(git diff --cached --name-only)\" '{systemMessage: (\"⚠️  Commit requested — staged files:\\n\" + $files + \"\\n\\nVerify scope before proceeding.\")}' || true"
          }
        ]
      }
    ]
  }
}
